# MAS web client environment overrides
#
# Copy this file to `.env.local` (which is git-ignored) and edit the values.
# Vite will substitute these at build/dev time.
#
# Use these when the API server runs on another machine on your LAN.
# Replace 10.136.64.45 with the LAN IP of the machine running `npm run dev:server`.

VITE_API_URL=http://10.136.64.45:4000
VITE_WS_URL=ws://10.136.64.45:4000

{
  "expo": {
    "name": "MAS Secure Messenger",
    "slug": "mas-secure",
    "version": "0.0.1",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.mas.secure",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-sharing",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow MAS Secure to access your camera for video calls.",
          "microphonePermission": "Allow MAS Secure to access your microphone for calls."
        }
      ]
    ]
  }
}

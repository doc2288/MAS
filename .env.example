# MAS public server defaults for port-forward + Caddy deployment.
# Copy values into your shell/service environment; do not commit real secrets.

NODE_ENV=production
HOST=127.0.0.1
PORT=4000
TRUST_PROXY=true
JWT_SECRET=replace-with-a-long-random-secret
DEV_AUTH_CODES=true

# Local web UI and Tauri desktop origins. Add more local dev ports only when needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,tauri://localhost,http://tauri.localhost

# Add your TURN server for reliable WebRTC across NAT. STUN-only fallback is built in.
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"mas","credential":"replace-me"}]

# Optional client build defaults. Users can also change this in the app settings.
VITE_API_URL=https://mas.example.com
VITE_WS_URL=wss://mas.example.com
